    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Клавиатура из трёх свободных окон: callback_data b:<recall_id>:<slot_id> (до 64 байт).\nconst slots = $json.slots || [];\nconst payload = { chat_id: $json.chat_id, text: slots.length ? $json.text : $json.text + ' Свободных окон сейчас нет: позвоните в клинику.' };\nif (slots.length) payload.reply_markup = { inline_keyboard: slots.map((s) => [{ text: s.label, callback_data: `b:${$json.recall_id}:${s.id}` }]) };\nreturn { json: { queue_id: $json.queue_id, recall_id: $json.recall_id, chat_id: $json.chat_id, payload } };"
      },
      "name": "Собрать клавиатуру",
