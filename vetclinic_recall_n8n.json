      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Сборка сообщения: ответ Ollama или запасной шаблон, если модель не ответила, ответ пустой или без клички.\nconst row = $('Питомцы на 14 дней').item.json;\nlet t = String($json.response || '').replace(/[*_`#]/g, '').trim();\nif (!t || t.length > 500 || !t.includes(row.pet_name)) {\n  t = `Здравствуйте${row.owner_name ? ', ' + row.owner_name : ''}! ${row.pet_name} через 14 дней (${row.due}) пора на плановую процедуру: ${row.procedure}. Выберите удобное время кнопкой ниже.`;\n}\nconst delay = Math.round(20 * $itemIndex * (1 + $itemIndex / 100)); // прогрессивная задержка: 20 с на сообщение, растёт с длиной очереди\nreturn { json: { recall_id: row.recall_id, chat_id: row.chat_id, text: t, delay_s: delay } };"
      },
      "name": "Собрать сообщение",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        1100
      ],
      "id": "0a6af402-f1f5-50d0-b6d7-790ea0601ae4",
      "notes": "Why Code: запасной шаблон, проверка клички в тексте модели и расчёт задержки в одном месте."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH q AS (INSERT INTO send_queue (recall_id, chat_id, text, send_after) VALUES ($1::bigint, $2::bigint, $3, now() + make_interval(secs => $4::int)) ON CONFLICT (recall_id) DO NOTHING RETURNING recall_id) UPDATE recall_schedule SET status = 'queued' WHERE id IN (SELECT recall_id FROM q) RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.recall_id, $json.chat_id, $json.text, $json.delay_s ] }}"
        }
      },
      "name": "Поставить в очередь",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
