        "jsonBody": "={{ JSON.stringify({ model: $env.OLLAMA_MODEL || 'qwen2.5:3b', stream: false, options: { temperature: 0.4 }, prompt: 'Напиши короткое тёплое сообщение по-русски (2 предложения, без эмодзи, без выдуманных фактов). Владелец: ' + ($json.owner_name || 'клиент') + '. Питомец по кличке ' + $json.pet_name + ' (' + ($json.species || 'питомец') + '). Через 14 дней, ' + $json.due + ', плановая процедура: ' + $json.procedure + '. Предложи выбрать время кнопкой ниже.' }) }}",
