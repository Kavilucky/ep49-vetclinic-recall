        "query": "WITH q AS (UPDATE send_queue SET status = CASE WHEN attempts >= 3 OR $2::boolean THEN 'failed' ELSE 'queued' END, send_after = now() + interval '30 minutes' * attempts WHERE id = $1::bigint RETURNING chat_id) UPDATE owners SET opt_in_status = 'opted_out' WHERE $2::boolean AND telegram_chat_id IN (SELECT chat_id FROM q) RETURNING id;",
        "options": {
