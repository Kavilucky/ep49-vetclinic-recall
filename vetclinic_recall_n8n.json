      "credentials": {
        "postgres": {
          "id": "",
          "name": "Vetclinic PostgreSQL"
        }
      },
      "notes": "Окно занимается атомарно одним запросом: два клиента не займут одно время. Часовой пояс в to_char поменяйте под свой регион.",
      "alwaysOutputData": true
    },
