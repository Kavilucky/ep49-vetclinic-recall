    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (SELECT id FROM send_queue WHERE status = 'queued' AND send_after <= now() ORDER BY send_after LIMIT 5 FOR UPDATE SKIP LOCKED) UPDATE send_queue q SET status = 'sending', attempts = q.attempts + 1 FROM c WHERE q.id = c.id RETURNING q.id AS queue_id, q.recall_id, q.chat_id, q.text, (SELECT json_agg(x) FROM (SELECT id, to_char(slot_start AT TIME ZONE 'Europe/Moscow', 'DD.MM HH24:MI') AS label FROM free_slots WHERE taken = false AND slot_start > now() ORDER BY slot_start LIMIT 3) x) AS slots;",
        "options": {}
      },
      "name": "Взять из очереди",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        1700
      ],
      "id": "685bdd03-917e-540b-971b-f82a6d1642aa",
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Vetclinic PostgreSQL"
        }
      },
      "notes": "Не больше 5 сообщений в минуту за запуск; задержки между клиентами задаются при постановке в очередь. Это защита от спама и блокировок.",
      "alwaysOutputData": true
    },
