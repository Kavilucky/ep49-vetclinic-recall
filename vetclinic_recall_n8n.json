    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (UPDATE free_slots SET taken = true WHERE id = $2::bigint AND taken = false AND EXISTS (SELECT 1 FROM send_queue q WHERE q.recall_id = $1::bigint AND q.chat_id = $3::bigint) RETURNING id, slot_start), a AS (INSERT INTO appointments (recall_id, slot_id, slot_start) SELECT $1::bigint, s.id, s.slot_start FROM s ON CONFLICT (recall_id) DO NOTHING RETURNING slot_start), r AS (UPDATE recall_schedule SET status = 'booked' WHERE id = $1::bigint AND EXISTS (SELECT 1 FROM a) RETURNING id) SELECT to_char(a.slot_start AT TIME ZONE 'Europe/Moscow', 'DD.MM HH24:MI') AS slot_label FROM a;",
        "options": {
          "queryReplacement": "={{ [ $json.recall_id, $json.slot_id, $json.chat_id ] }}"
        }
      },
      "name": "Занять окно и записать",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
