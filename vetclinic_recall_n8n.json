    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Разбор callback_data вида b:<recall_id>:<slot_id>. Чужие и битые данные отбрасываются.\nconst cq = $json.callback_query;\nconst m = /^b:(\\d+):(\\d+)$/.exec(cq.data || '');\nreturn { json: { ok: !!m, recall_id: m ? Number(m[1]) : 0, slot_id: m ? Number(m[2]) : 0, chat_id: cq.message.chat.id, cq_id: cq.id } };"
      },
      "name": "Разобрать кнопку",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -200
      ],
      "id": "59518f8c-7477-5860-8631-1416163b3fd2",
      "notes": "Why Code: разбор callback_data регулярным выражением и проверка формата."
    },
