    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO owners (phone_e164, name, telegram_chat_id, opt_in_status, opt_in_at, opt_in_text) VALUES ($1, NULLIF($2, ''), $3::bigint, 'opted_in', now(), $4) ON CONFLICT (phone_e164) DO UPDATE SET telegram_chat_id = EXCLUDED.telegram_chat_id, opt_in_status = 'opted_in', opt_in_at = now(), opt_in_text = EXCLUDED.opt_in_text, name = COALESCE(owners.name, EXCLUDED.name) RETURNING id;",
        "options": {
