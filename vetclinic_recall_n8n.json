    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT rs.id AS recall_id, o.telegram_chat_id AS chat_id, COALESCE(o.name, '') AS owner_name, p.name AS pet_name, COALESCE(p.species, '') AS species, rs.procedure, to_char(rs.due_date, 'DD.MM.YYYY') AS due FROM recall_schedule rs JOIN pets p ON p.id = rs.pet_id JOIN owners o ON o.id = p.owner_id WHERE rs.status = 'planned' AND rs.due_date = current_date + 14 AND o.opt_in_status = 'opted_in' AND o.telegram_chat_id IS NOT NULL ORDER BY rs.id;",
        "options": {}
      },
      "name": "Питомцы на 14 дней",
      "type": "n8n-nodes-base.postgres",
