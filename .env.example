# Скопируйте в .env и заполните. Файл .env не публикуйте и храните копию отдельно от сервера.
# Сгенерировать значения: openssl rand -hex 32
POSTGRES_USER=vetclinic
POSTGRES_PASSWORD=СМЕНИТЕ_НА_СЛУЧАЙНОЕ
POSTGRES_DB=vetclinic
N8N_ENCRYPTION_KEY=СМЕНИТЕ_НА_СЛУЧАЙНОЕ_И_НЕ_МЕНЯЙТЕ
HOST=bot.example-vet.ru
TZ=Europe/Moscow
TUNNEL_TOKEN=ВСТАВЬТЕ_ТОКЕН_ТУННЕЛЯ_CLOUDFLARE
TELEGRAM_BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_БОТА_ОТ_BOTFATHER
ADMIN_CHAT_ID=0
CLINIC_NAME=Ветклиника Пример
# Модель для Ollama (пример, не проверялась): подберите по железу и проверьте качество русского текста
OLLAMA_MODEL=qwen2.5:3b
